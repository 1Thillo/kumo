                color: Theme.text2;
            }
        }
    }
}

// ---------------------------------------------------------------- window

export component PanelWindow inherits Window {
    title: "Kumo";
    icon: @image-url("../assets/kumo-icon.png");
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 520px;
    default-font-family: Theme.ui-font;
    default-font-size: 14px;
    background: Theme.bg-base;
    forward-focus: keys;

    public function set-dark(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    function go(page: int) {
        State.pick-mode = false;
        State.page = page;
    }

    keys := FocusScope {
    focus-on-tab-navigation: false;
    focus-on-click: false;
    key-pressed(e) => {
        if (e.text == Key.Escape && State.pick-mode) {
            State.cancel-pick();
            return accept;
        }
        if (e.text == Key.Escape && State.page == 1) {
            State.page = 0;
            return accept;
        }
        if (e.modifiers.control) {
            if (e.text == "1" || e.text == "2" || e.text == "3") {
                root.go(e.text == "1" ? 0 : e.text == "2" ? 2 : 3);
                return accept;
            }
            if (e.text == ",") {
                root.go(4);
                return accept;
            }
            if (e.text == "o") {
                State.add-files();
                return accept;
            }
        }
        return reject;
    }
    HorizontalLayout {
        // sidebar
        VerticalLayout {
            width: 216px;
            padding: 4px;
            padding-top: 12px;
            spacing: 2px;
            HorizontalLayout {
                height: 40px;
                padding-left: 12px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 24px;
                        height: 24px;
                        source: @image-url("../assets/kumo-icon.png");
                    }
                }
                Text {
                    text: "Kumo";
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
            }
            Rectangle { height: 8px; }
            NavItem {
                icon: "\u{E8F1}";
                label: @tr("Library");
                selected: State.page <= 1;
                clicked => { root.go(0); }
            }
            NavItem {
                icon: "\u{E7F4}";
                label: @tr("Screens");
                selected: State.page == 2;
                clicked => { root.go(2); }
            }
            NavItem {
                icon: "\u{EC4A}";
                label: @tr("Playback & performance");
                selected: State.page == 3;
                clicked => { root.go(3); }
            }
            Rectangle { vertical-stretch: 1; }
            // status chip
            Rectangle {
                height: 32px;
                border-radius: 4px;
                background: sc.has-hover ? Theme.subtle-hover : transparent;
                accessible-role: button;
                accessible-label: !State.running ? @tr("Not running") : State.paused ? @tr("Paused") : @tr("Running");
                accessible-action-default => { root.go(3); }
                sc := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.go(3); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: !State.running ? Theme.critical : State.paused ? Theme.text3 : Theme.success;
                        }
                    }
                    Text {
                        text: (!State.running ? @tr("Not running") : State.paused ? @tr("Paused") : @tr("Running")) + (State.running ? " · " + State.ram : "");
                        font-size: 12px;
                        color: Theme.text2;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle {
                height: 9px;
                Rectangle {
                    height: 1px;
                    width: parent.width - 24px;
                    background: Theme.divider;
                }
            }
            NavItem {
                icon: "\u{E713}";
                label: @tr("Settings");
                selected: State.page == 4;
                clicked => { root.go(4); }
            }
            NavItem {
                icon: "\u{E946}";
                label: @tr("About Kumo");
                selected: State.page == 5;
                clicked => { root.go(5); }
            }
            Rectangle { height: 8px; }
        }
        // content layer
        Rectangle {
            background: Theme.bg-layer;
            border-top-left-radius: 8px;
            border-width: 1px;
            border-color: Theme.stroke;
            clip: true;
            VerticalLayout {
                if State.info-kind > 1 || (State.info-kind == 1 && State.page == 0): HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 16px;
                    InfoBar {
                        kind: State.info-kind;
                        message: State.info-text;
                        action: State.info-action;
                        action-clicked => { State.info-action-clicked(); }
                        dismissed => { State.info-dismissed(); }
                    }
                }
                if State.page == 0: LibraryPage { vertical-stretch: 1; }
                if State.page == 1: DetailPage { vertical-stretch: 1; }
                if State.page == 2: DisplaysPage { vertical-stretch: 1; }
                if State.page == 3: PerformancePage { vertical-stretch: 1; }
                if State.page == 4: SettingsPage { vertical-stretch: 1; }
                if State.page == 5: AboutPage { vertical-stretch: 1; }
            }
            if State.dragging: Rectangle {
                background: State.drag-ok ? Theme.accent-tint : Theme.critical-bg;
                Rectangle {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: parent.height - 24px;
                    border-radius: 8px;
                    border-width: 2px;
                    border-color: State.drag-ok ? Theme.accent : Theme.critical;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Icon {
                            text: State.drag-ok ? "\u{E896}" : "\u{E783}";
                            font-size: 48px;
                            color: State.drag-ok ? Theme.accent : Theme.critical;
                        }
                        Text {
                            text: State.drag-ok ? @tr("Release to add") : @tr("This format is not supported");
                            font-size: 20px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            color: Theme.text;
                        }
                        Text {
                            text: "MP4 · WebM · MKV · JPG · PNG · WebP · BMP · .kumo";
                            font-size: 12px;
                            horizontal-alignment: center;
                            color: Theme.text2;
                        }
                    }
                }
            }
        }
    }
    }
}

// The big number on each screen while "Identify" runs.
export component IdentifyWindow inherits Window {
    in property <string> label;
    no-frame: true;
    always-on-top: true;
    width: 160px;
    height: 160px;
    background: Theme.accent;
    Text {
        text: root.label;
        font-size: 96px;
        font-weight: 600;
        color: Theme.accent-text;
    }
}
